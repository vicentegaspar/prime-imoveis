---
import { property } from '../data/property';

const stats = [
  { label: 'Quartos', value: property.bedrooms },
  { label: 'Banheiros', value: property.bathrooms },
  { label: 'Vagas', value: property.parkingSpaces },
  { label: 'Área', value: `${property.areaSqm} m²` },
];
---

<section id="detalhes" class="bg-slate-50 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <header class="mb-10 max-w-2xl">
      <p class="text-sm font-medium uppercase tracking-wider text-emerald-700">Detalhes</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        O que esse imóvel oferece
      </h2>
    </header>

    <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      {stats.map((stat) => (
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">
            {stat.label}
          </dt>
          <dd class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            {stat.value}
          </dd>
        </div>
      ))}
    </dl>

    {property.features.length > 0 && (
      <div class="mt-10">
        <h3 class="text-base font-semibold text-slate-900">Diferenciais</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {property.features.map((feature) => (
            <li class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700">
              {feature}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
