---
import { property } from '../data/property';

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="text-base font-semibold text-slate-900">Prime Imóveis</p>
        <p class="mt-1 max-w-md text-sm text-slate-600">
          {property.address.street}, {property.address.neighborhood} —{' '}
          {property.address.city}/{property.address.state}
        </p>
      </div>

      <div class="text-sm text-slate-600">
        <p>{property.contact.phone}</p>
        <p>
          <a href={`mailto:${property.contact.email}`} class="hover:text-slate-900">
            {property.contact.email}
          </a>
        </p>
      </div>
    </div>

    <p class="mt-8 text-xs text-slate-500">
      © {year} Prime Imóveis. Todos os direitos reservados.
    </p>
  </div>
</footer>
