---
import { property } from '../data/property';

const primary = property.images[0];
const rentBRL = new Intl.NumberFormat('pt-BR', {
  style: 'currency',
  currency: 'BRL',
  maximumFractionDigits: 0,
}).format(property.rentMonthlyBRL);
---

<section id="top" class="relative isolate overflow-hidden">
  <img
    src={primary?.src}
    alt={primary?.alt ?? property.name}
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-slate-900/70 via-slate-900/40 to-slate-900/80"></div>

  <div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-6xl flex-col justify-end px-4 pb-16 pt-32 sm:px-6 sm:pb-24 sm:pt-40">
    <p class="text-sm font-medium uppercase tracking-wider text-white/80">
      Aluguel · {property.address.neighborhood}, {property.address.city}/{property.address.state}
    </p>
    <h1 class="mt-3 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-white sm:text-5xl">
      {property.name}
    </h1>
    <p class="mt-4 max-w-2xl text-base text-white/85 sm:text-lg">
      {property.description}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <div class="rounded-lg bg-white/95 px-4 py-3 text-slate-900 shadow-lg">
        <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Aluguel mensal</p>
        <p class="text-2xl font-bold">{rentBRL}</p>
      </div>
      <a
        href="#contato"
        class="inline-flex items-center gap-2 rounded-md bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-emerald-700"
      >
        Quero agendar uma visita
      </a>
    </div>
  </div>
</section>
