---
import { property } from '../data/property';

const waMessage = encodeURIComponent(
  `Olá! Tenho interesse em alugar o imóvel "${property.name}". Pode me ajudar?`,
);
const waHref = `https://wa.me/${property.contact.whatsapp}?text=${waMessage}`;
---

<section id="contato" class="bg-slate-900 py-16 text-white sm:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2">
    <div>
      <p class="text-sm font-medium uppercase tracking-wider text-emerald-400">Contato</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
        Agende uma visita
      </h2>
      <p class="mt-4 max-w-md text-slate-300">
        Deixe seu contato e retornamos em até 1 dia útil. Para resposta imediata,
        chame no WhatsApp.
      </p>

      <a
        href={waHref}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-flex items-center gap-2 rounded-md bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-emerald-700"
      >
        Falar agora no WhatsApp
      </a>

      <dl class="mt-10 space-y-3 text-sm text-slate-300">
        <div>
          <dt class="font-medium text-slate-400">Telefone</dt>
          <dd>{property.contact.phone}</dd>
        </div>
        <div>
          <dt class="font-medium text-slate-400">E-mail</dt>
          <dd>
            <a class="hover:text-white" href={`mailto:${property.contact.email}`}>
              {property.contact.email}
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <form
      method="POST"
      action="/api/contact"
      class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10 backdrop-blur sm:p-8"
    >
      <!-- Honeypot: bots will fill this; humans will not. Backend Worker rejects when set. -->
      <div class="hidden" aria-hidden="true">
        <label>Não preencher: <input name="company" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block sm:col-span-2">
          <span class="text-sm font-medium text-slate-200">Nome completo</span>
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            class="mt-1 block w-full rounded-md border-0 bg-white/10 px-3 py-2.5 text-white shadow-sm ring-1 ring-inset ring-white/10 placeholder:text-slate-400 focus:ring-2 focus:ring-emerald-500"
          />
        </label>

        <label class="block">
          <span class="text-sm font-medium text-slate-200">Telefone</span>
          <input
            type="tel"
            name="phone"
            required
            autocomplete="tel"
            placeholder="(11) 99999-9999"
            class="mt-1 block w-full rounded-md border-0 bg-white/10 px-3 py-2.5 text-white shadow-sm ring-1 ring-inset ring-white/10 placeholder:text-slate-400 focus:ring-2 focus:ring-emerald-500"
          />
        </label>

        <label class="block">
          <span class="text-sm font-medium text-slate-200">E-mail</span>
          <input
            type="email"
            name="email"
            autocomplete="email"
            class="mt-1 block w-full rounded-md border-0 bg-white/10 px-3 py-2.5 text-white shadow-sm ring-1 ring-inset ring-white/10 placeholder:text-slate-400 focus:ring-2 focus:ring-emerald-500"
          />
        </label>

        <label class="block sm:col-span-2">
          <span class="text-sm font-medium text-slate-200">Mensagem</span>
          <textarea
            name="message"
            rows="4"
            placeholder="Quando tem disponibilidade para uma visita?"
            class="mt-1 block w-full rounded-md border-0 bg-white/10 px-3 py-2.5 text-white shadow-sm ring-1 ring-inset ring-white/10 placeholder:text-slate-400 focus:ring-2 focus:ring-emerald-500"
          ></textarea>
        </label>
      </div>

      <button
        type="submit"
        class="mt-6 inline-flex w-full items-center justify-center rounded-md bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-emerald-700 sm:w-auto"
      >
        Enviar mensagem
      </button>
      <p class="mt-3 text-xs text-slate-400">
        Endpoint <code>/api/contact</code> será implementado pelo Backend Agent (Cloudflare Worker — fase 2).
      </p>
    </form>
  </div>
</section>
