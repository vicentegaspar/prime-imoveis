---
import { property } from '../data/property';

const waHref = `https://wa.me/${property.contact.whatsapp}`;
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="#top" class="flex items-center gap-2 font-semibold tracking-tight text-slate-900">
      <span class="grid h-8 w-8 place-items-center rounded-md bg-slate-900 text-sm font-bold text-white">P</span>
      Prime Imóveis
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-slate-600 md:flex">
      <a href="#detalhes" class="hover:text-slate-900">Detalhes</a>
      <a href="#galeria" class="hover:text-slate-900">Galeria</a>
      <a href="#localizacao" class="hover:text-slate-900">Localização</a>
      <a href="#contato" class="hover:text-slate-900">Contato</a>
    </nav>

    <a
      href={waHref}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 rounded-md bg-emerald-600 px-3 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-emerald-700"
    >
      WhatsApp
    </a>
  </div>
</header>
