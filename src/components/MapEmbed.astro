---
import { property } from '../data/property';

const { latitude, longitude, street, neighborhood, city, state } = property.address;

// OpenStreetMap embed: no API key required. The bbox is a small box around
// the property; the marker is the exact point. Switch to Google Maps embed
// later if SEO/Places integration is desired.
const delta = 0.005;
const bbox = `${longitude - delta},${latitude - delta},${longitude + delta},${latitude + delta}`;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${latitude},${longitude}`;
const directionsHref = `https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}#map=17/${latitude}/${longitude}`;
---

<section id="localizacao" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <header class="mb-10 max-w-2xl">
      <p class="text-sm font-medium uppercase tracking-wider text-emerald-700">Localização</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Onde fica o imóvel
      </h2>
      <p class="mt-3 text-slate-600">
        {street} — {neighborhood}, {city}/{state}
      </p>
    </header>

    <div class="overflow-hidden rounded-xl border border-slate-200 shadow-sm">
      <iframe
        src={mapSrc}
        title={`Mapa de ${street}, ${neighborhood}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="h-[420px] w-full border-0"
      ></iframe>
    </div>

    <p class="mt-4 text-sm">
      <a
        href={directionsHref}
        target="_blank"
        rel="noopener"
        class="font-medium text-emerald-700 hover:text-emerald-800"
      >
        Abrir no OpenStreetMap →
      </a>
    </p>
  </div>
</section>
